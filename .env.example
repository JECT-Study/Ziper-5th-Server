# Run scripts/local-setup.sh to generate local secrets. Never commit .env.
POSTGRES_USER=ziper_admin
POSTGRES_DB=ziper
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
DB_JDBC_URL=jdbc:postgresql://localhost:5432/ziper
DB_USERNAME=ziper_app
DB_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
MIGRATION_JDBC_URL=jdbc:postgresql://localhost:5432/ziper
MIGRATION_USERNAME=ziper_migrator
MIGRATION_PASSWORD=REPLACE_WITH_RANDOM_MIGRATION_PASSWORD
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
JWT_ISSUER=ziper-server
JWT_AUDIENCE=ziper-api
CORS_ALLOWED_ORIGINS=http://localhost:3000
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=local
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.0
SWAGGER_ENABLED=false
# Email verification uses EMAIL_MAIL_ENABLED and EMAIL_CODE_SECRET_BASE64.
# Keep real SMTP credentials only in the untracked .env file.
EMAIL_MAIL_ENABLED=false
EMAIL_FROM=your-address@gmail.com
EMAIL_CODE_SECRET_BASE64=REPLACE_WITH_BASE64_ENCODED_EMAIL_CODE_SECRET
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
